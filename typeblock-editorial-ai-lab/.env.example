# Never commit your real key. Copy this file to .env locally.
OPENAI_API_KEY=sk-proj-replace-me

# Keep this aligned with the browser Cost Ledger unless you also update core.js.
OPENAI_MODEL=gpt-5-mini

# Pricing snapshot used for usage-based cost calculation, USD per 1M tokens.
OPENAI_INPUT_PRICE_PER_M=0.25
OPENAI_CACHED_INPUT_PRICE_PER_M=0.025
OPENAI_OUTPUT_PRICE_PER_M=2.00

PORT=8787
