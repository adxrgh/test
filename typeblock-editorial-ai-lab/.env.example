# Never commit your real key. Copy this file to .env locally.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# OpenRouter model id.
OPENROUTER_MODEL=openai/gpt-5-mini

# Fallback pricing only. LIVE prefers OpenRouter's reported usage.cost when present.
# USD per 1M tokens.
OPENROUTER_INPUT_PRICE_PER_M=0.25
OPENROUTER_CACHED_INPUT_PRICE_PER_M=0.025
OPENROUTER_OUTPUT_PRICE_PER_M=2.00

PORT=8787
